---
import { Icon } from "astro-icon/components";

export interface StackItem {
  name: string;
  step: string;
  description: string;
  version: string;
  icon: string;
}

export interface Props {
  items: StackItem[];
}

const { items } = Astro.props as Props;

function hasVersion(version: string | undefined): version is string {
  if (!version) return false;

  const normalized = version.trim().toLowerCase();
  return normalized !== "" && normalized !== "n/a" && normalized !== "na";
}
---

<section class="stack-marquee" aria-labelledby="stack-title">
  <h2 id="stack-title" class="sr-only">Tecnologías utilizadas</h2>

  <ul class="stack__grid">
    {
      items.map((item) => (
        <li
          class:list={[
            "stack__item",
            { "stack__item--wide": item.name.toLowerCase() === "Blueprint" },
          ]}
        >
          <p class="stack__step">{item.step}</p>

          <Icon name={item.icon} class="stack__icon" aria-hidden="true" />

          <span class="stack__name">{item.name}</span>

          <span class="stack__description">{item.description}</span>

          {hasVersion(item.version) && (
            <small class="stack__version">{item.version}</small>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .stack-marquee {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-bg-secondary);
  }

  .stack__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;

    width: 100%;
    margin: 0;
    padding: 1rem;

    list-style: none;
  }

  .stack__item {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto auto;
    align-items: center;
    justify-items: center;

    min-width: 0;
    min-height: 12rem;
    padding: 1.25rem 1.5rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg-primary) 96%, white),
      var(--color-bg-primary)
    );
    box-shadow: var(--shadow-sm);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .stack__item:hover {
    border-color: var(--color-brand-primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .stack__step {
    grid-row: 1;
    margin: 0 0 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .stack__icon {
    grid-row: 2;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.6rem;
    color: var(--color-brand-primary);
  }

  .stack__name {
    grid-row: 3;
    color: var(--color-text-primary);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .stack__description {
    grid-row: 4;
    max-width: 15rem;
    margin: 0.6rem 0 0;
    color: var(--muted-foreground);
    font-size:1rem;
    font-weight: 400;
    line-height: 1.65;
    text-align: center;
  }

  .stack__version {
    grid-row: 5;
    margin-top: 0.8rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 700px) and (max-width: 800px) {
    .stack__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stack__item--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 801px) and (max-width: 900px) {
    .stack__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .stack__grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .stack__item {
      min-height: 11rem;
      padding: 1.25rem 1rem;
      border-radius: var(--radius-xl);
    }

    .stack__name {
      font-size: 1.15rem;
    }

    .stack__description {
      max-width: 16rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 360px) {
    .stack__item {
      min-height: 10.5rem;
      padding-inline: 0.85rem;
    }

    .stack__description {
      max-width: 14rem;
      font-size: 0.75rem;
    }
  }
</style>